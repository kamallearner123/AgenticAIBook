    "from pydantic import BaseModel\n",
    "\n",
    "class UserProfile(BaseModel):\n",
    "    name: str\n",
    "    age: int\n",
    "    email: str\n",
    "\n",
    "user = UserProfile(name=\"Liam Svensson\", age=40, email=\"liam.svensson@example.com\")\n",
    "print(user)"
